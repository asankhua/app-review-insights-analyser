# Groq API (required for phases 2)
GROQ_API_KEY=your_groq_api_key_here

# Gemini API (required for phases 3)
GEMINI_API_KEY=your_gemini_api_key_here

# Email (required for phase 4). For Gmail: use an App Password (not your normal password).
# Create at: Google Account → Security → 2-Step Verification → App passwords.
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECIPIENT=recipient@example.com

# Resend (optional). If set, email is sent via Resend; else SMTP with EMAIL_SENDER/EMAIL_PASSWORD.
# RESEND_API_KEY=re_xxxx

# Gist (optional). For report upload and "View Report" from Gist. Use PAT with gist scope.
# GH_GIST_TOKEN=ghp_xxxx
# REPORT_GIST_ID=your_gist_id

# Phase 7: Fee explanation (optional). If set, fetches exit load/fee from URL and adds section to email.
# FEE_EXPLANATION_URL=https://www.indmoney.com/mutual-funds/hdfc-mid-cap-fund-direct-plan-growth-option-3097
# When the URL blocks automated fetch (403), set EXIT_LOAD_VALUE so email/doc still show it (e.g. "1% if redeemed within 1 year").
# EXIT_LOAD_VALUE=1% if redeemed within 1 year

# Phase 8: Combined report → Google Doc (optional). Doc ID or full Doc URL. Share the Doc with the service account email.
# GOOGLE_DOC_ID=your_google_doc_id_or_url
# Phase 8 MCP (primary): use MCP server to append (e.g. google-docs-mcp-server). Unset = use Google Docs API fallback.
# MCP_GOOGLE_DOCS_USE_MCP=1
# MCP_GOOGLE_DOCS_MCP_COMMAND=uvx
# MCP_GOOGLE_DOCS_MCP_ARGS=google-docs-mcp-server
# MCP_GOOGLE_DOCS_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
# MCP_GOOGLE_DOCS_SUBJECT_EMAIL=you@yourdomain.com
